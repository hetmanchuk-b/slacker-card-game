{
  "name": "penky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "test:postgres": "node src/persistence/testing/run-postgres.ts",
    "test:browser": "playwright test",
    "dev": "node src/dev/cli.ts",
    "db:test:up": "docker compose -f compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yml down --volumes",
    "db:migrate": "node src/persistence/cli/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "eslint src tests *.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \"*.mjs\" \"*.yml\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \"*.mjs\" \"*.yml\" \".github/**/*.yml\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
